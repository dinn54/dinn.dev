{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": [
			"biome.json",
			"tsconfig.json",
			"src/app/globals.css",
			"node_modules",
			"dist",
			"build",
			"public",
			".next",
			"eslint.config.mjs",
			"package.json",			"nest.config.ts",
			"pnpm-lock.yaml",
			"postcss.config.mjs",
			"prettier.config.js"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"useFocusableInteractive": "error",
				"useKeyWithClickEvents": "error",
				"useKeyWithMouseEvents": "error",
				"noAccessKey": "error",
				"noPositiveTabindex": "error",
				"noNoninteractiveTabindex": "error",
				"useButtonType": "error",
				"useSemanticElements": "warn",
				"useValidAnchor": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
